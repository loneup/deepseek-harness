{
  "name": "@deepseek-ai/dsh-host-nexus-bridge",
  "description": "Nexus Bridge route-registration plugin for the dsh Web host",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/nexus-bridge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-host-nexus-compat": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
